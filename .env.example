# Copy this file to .env for local development. Never commit real secrets.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
ANAM_AGENT_ID=854eaac4-bd3b-40f6-9f0c-26970e0a7c19
VTIC_SECRET_KEY=replace-with-a-long-random-secret
VTIC_ADMIN_USERNAME=admin
VTIC_ADMIN_PASSWORD=replace-with-a-secure-password

# Optional customer social sign-in credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Apple client ID is the Services ID; APPLE_CLIENT_SECRET is its generated JWT.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Outbound approval notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
