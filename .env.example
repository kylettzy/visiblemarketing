DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=require
# Copy this file to .env for local development. Never commit real secrets.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
ANAM_AGENT_ID=
VTIC_SECRET_KEY=replace-with-a-long-random-secret
VTIC_ADMIN_USERNAME=admin
VTIC_ADMIN_PASSWORD=replace-with-a-secure-password
# Optional override. The application defaults to ./vtic_store.db.
VTIC_DATABASE_PATH=

# Optional customer social sign-in credentials.
# Public Cloudflare hostname, without a trailing slash. This keeps OAuth
# callbacks correct behind Cloudflare Tunnel (for example https://portal.example.com).
VTIC_PUBLIC_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Apple client ID is the Services ID; APPLE_CLIENT_SECRET is its generated JWT.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Outbound approval notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false

# Meta Page gallery synchronization. Never commit real token values.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
